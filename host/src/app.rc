// Windows version info shown in the exe's Properties > Details.
#include <winver.h>

#ifndef PD_VERSION_MAJOR
#define PD_VERSION_MAJOR 0
#define PD_VERSION_MINOR 0
#define PD_VERSION_PATCH 0
#define PD_VERSION_STR "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PD_VERSION_MAJOR, PD_VERSION_MINOR, PD_VERSION_PATCH, 0
 PRODUCTVERSION PD_VERSION_MAJOR, PD_VERSION_MINOR, PD_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Nezucloud"
            VALUE "FileDescription", "PadDisplay by Nezucloud - use an Android tablet as a second monitor"
            VALUE "FileVersion", PD_VERSION_STR
            VALUE "InternalName", "PadDisplay"
            VALUE "LegalCopyright", "Copyright (c) 2026 Nezucloud. MIT License."
            VALUE "OriginalFilename", "PadDisplay.exe"
            VALUE "ProductName", "PadDisplay by Nezucloud"
            VALUE "ProductVersion", PD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
